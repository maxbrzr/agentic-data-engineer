#!/bin/sh
set -eu

usage() {
    echo "Usage: scripts/pi run <dataset-key> <data-dir-name> <request-file>" >&2
    exit 2
}

[ "${1:-}" = "run" ] || usage
example_key=${2:-}
data_dir_name=${3:-}
request_file=${4:-}

case "$example_key" in
    ""|.*|*/*|*[!A-Za-z0-9._-]*) usage ;;
esac
case "$data_dir_name" in
    ""|"."|".."|*/*) usage ;;
esac

[ -f "$request_file" ] || usage

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
compose_file="$project_root/compose.pi.yml"
dataset_dir="$project_root/data/$data_dir_name"
output_dir="$project_root/output/$example_key"

case "$request_file" in
    "$output_dir"/*) ;;
    *)
        echo "Pi request file must be inside $output_dir" >&2
        exit 2
        ;;
esac

mkdir -p "$dataset_dir" "$output_dir"

ADE_UID=$(id -u)
ADE_GID=$(id -g)
export ADE_ROOT="$project_root"
export ADE_UID
export ADE_GID
export EXAMPLE_KEY="$example_key"
export DATA_DIR_NAME="$data_dir_name"
export PI_REQUEST_FILE="$request_file"

exec docker compose --file "$compose_file" run \
    --build \
    --rm \
    --no-deps \
    -T \
    pi
