#!/bin/sh
set -eu

usage() {
    echo "Usage: scripts/opencode-sandbox {start|stop|logs|status|probe|config} <example-key>" >&2
    echo "Example keys: tcm-predictive-maintenance, chemical-process-safety, industry-5-cyber-physical-systems" >&2
    exit 2
}

command_name=${1:-}
example_key=${2:-}

case "$command_name" in
    start|stop|logs|status|probe|config) ;;
    *) usage ;;
esac

case "$example_key" in
    tcm-predictive-maintenance|chemical-process-safety|industry-5-cyber-physical-systems) ;;
    *) usage ;;
esac

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
compose_file="$project_root/compose.opencode-sandbox.yml"
dataset_dir="$project_root/data/$example_key"
output_dir="$project_root/output/$example_key"

mkdir -p "$dataset_dir" "$output_dir"

ADE_UID=$(id -u)
ADE_GID=$(id -g)
export ADE_ROOT="$project_root"
export ADE_UID
export ADE_GID
export EXAMPLE_KEY="$example_key"

case "$command_name" in
    start)
        exec docker compose --file "$compose_file" up \
            --build \
            --detach \
            --wait \
            --force-recreate
        ;;
    stop)
        exec docker compose --file "$compose_file" down
        ;;
    logs)
        exec docker compose --file "$compose_file" logs --follow opencode
        ;;
    status)
        exec docker compose --file "$compose_file" ps
        ;;
    config)
        exec docker compose --file "$compose_file" config
        ;;
    probe)
        docker compose --file "$compose_file" exec -T opencode sh -c '
            set -eu
            data_probe="$1/.opencode-sandbox-write-probe"
            output_probe="$2/.opencode-sandbox-write-probe"
            workspace_probe="$3/.opencode-sandbox-write-probe"

            if touch "$data_probe" 2>/dev/null; then
                rm -f "$data_probe"
                echo "ERROR: raw data is writable" >&2
                exit 1
            fi
            if touch "$workspace_probe" 2>/dev/null; then
                rm -f "$workspace_probe"
                echo "ERROR: workspace root is writable" >&2
                exit 1
            fi
            touch "$output_probe"
            rm -f "$output_probe"
            echo "Sandbox probe passed: data and workspace root are read-only; selected output is writable."
        ' sh "$dataset_dir" "$output_dir" "$project_root"
        ;;
esac
