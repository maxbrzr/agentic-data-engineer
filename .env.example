# Optional GWDG SAIA integration. Copy this file to .env and add a current key.
SAIA_API_KEY=

# Optional KIT KI-Toolbox integration. Generate the key in Settings > Accounts.
KIT_TOOLBOX_API_KEY=

# Optional Helmholtz Blablador integration. Use a Helmholtz Codebase personal
# access token with the read_user scope (valid for at most one year).
BLABLADOR_API_KEY=
