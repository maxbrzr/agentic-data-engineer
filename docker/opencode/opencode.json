{
  "$schema": "https://opencode.ai/config.json",
  "model": "kit/kit.deepseek-v4-flash",
  "small_model": "kit/kit.deepseek-v4-flash",
  "enabled_providers": [
    "blablador",
    "gwdg",
    "kit",
    "opencode"
  ],
  "provider": {
    "blablador": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Helmholtz Blablador",
      "options": {
        "baseURL": "https://api.blablador.fz-juelich.de/v1",
        "apiKey": "{env:BLABLADOR_API_KEY}"
      },
      "models": {
        "alias-code": {
          "name": "Blablador code (Qwen3.8 27B, 262k context)"
        },
        "alias-fast": {
          "name": "Blablador fast (GPT-OSS 120B, 131k context)"
        },
        "alias-large": {
          "name": "Blablador large (Qwen3.8 Flash Next)"
        },
        "alias-huge": {
          "name": "Blablador huge (MiniMax M2.7, slow)"
        }
      }
    },
    "gwdg": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GWDG SAIA",
      "options": {
        "baseURL": "https://chat-ai.academiccloud.de/v1",
        "apiKey": "{env:SAIA_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731 (GWDG SAIA)"
        },
        "gemma-4-31b-it": {
          "name": "Gemma 4 31B Instruct (GWDG SAIA)"
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash (GWDG SAIA)"
        },
        "meta-llama-3.1-8b-instruct": {
          "name": "Llama 3.1 8B Instruct (GWDG SAIA)"
        },
        "qwen3-30b-a3b-instruct-2507": {
          "name": "Qwen 3 30B A3B Instruct 2507 (GWDG SAIA)"
        },
        "qwen3-coder-next": {
          "name": "Qwen 3 Coder Next (GWDG SAIA)"
        },
        "qwen3-omni-30b-a3b-instruct": {
          "name": "Qwen 3 Omni 30B A3B Instruct (GWDG SAIA)"
        },
        "qwen3.5-397b-a17b": {
          "name": "Qwen 3.5 397B A17B (GWDG SAIA)"
        },
        "qwen3.6-35b-a3b": {
          "name": "Qwen 3.6 35B A3B (GWDG SAIA)"
        },
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B (GWDG SAIA)"
        }
      }
    },
    "kit": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KIT KI-Toolbox",
      "options": {
        "baseURL": "https://ki-toolbox.scc.kit.edu/api/v1",
        "apiKey": "{env:KIT_TOOLBOX_API_KEY}"
      },
      "models": {
        "kit.mistral-small-4-119b-a8b": {
          "name": "Mistral Small 4 119B (local KIT)"
        },
        "kit.deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (local KIT)"
        },
        "kit.glm-5.3-flash": {
          "name": "GLM-5.3 Flash (local KIT)"
        }
      }
    }
  },
  "share": "disabled",
  "permission": {
    "*": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": {
      "*": "allow",
      "data": "deny",
      "data/**": "deny"
    },
    "bash": "allow",
    "external_directory": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "question": "deny",
    "doom_loop": "deny"
  }
}
