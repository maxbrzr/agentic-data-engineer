{
  "name": "KIT KI-Toolbox",
  "docs": "https://www.scc.kit.edu/dienste/ki-toolbox.php#KI-Modelle",
  "base_url": "https://ki-toolbox.scc.kit.edu/api/v1",
  "api_key_env": "KIT_TOOLBOX_API_KEY",
  "harnesses": [
    "opencode",
    "pi"
  ],
  "default_model": "kit.deepseek-v4-flash",
  "ignore": [
    "alias.",
    "azure.",
    "google.",
    "standard-",
    "kit.flux",
    "kit.qwen3-embedding",
    "kit.qwen3-reranker",
    "kit.voxtral",
    "kit.whisper"
  ],
  "models": [
    {
      "id": "kit.mistral-small-4-119b-a8b",
      "name": "Mistral Small 4 119B (local KIT)"
    },
    {
      "id": "kit.deepseek-v4-flash",
      "name": "DeepSeek V4 Flash (local KIT)"
    },
    {
      "id": "kit.glm-5.3-flash",
      "name": "GLM-5.3 Flash (local KIT)"
    }
  ]
}
